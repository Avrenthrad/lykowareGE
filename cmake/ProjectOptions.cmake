option(LYKOWARE_WARNINGS_AS_ERRORS "Treat project compiler warnings as errors" ON)
option(LYKOWARE_SANITIZERS "Enable Address/UndefinedBehavior Sanitizer on GCC/Clang" OFF)
option(LYKOWARE_CLANG_TIDY "Enable clang-tidy 18 analysis" OFF)

if(LYKOWARE_CLANG_TIDY)
    find_program(LYKOWARE_CLANG_TIDY_EXE NAMES clang-tidy-18 REQUIRED)
endif()

function(lykoware_configure_target target)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /permissive- /utf-8)
        if(LYKOWARE_WARNINGS_AS_ERRORS)
            target_compile_options(${target} PRIVATE /WX)
        endif()
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
        if(LYKOWARE_WARNINGS_AS_ERRORS)
            target_compile_options(${target} PRIVATE -Werror)
        endif()
    endif()

    if(LYKOWARE_SANITIZERS)
        if(WIN32 OR NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang)$")
            message(FATAL_ERROR "The sanitizer preset requires Linux GCC or Clang")
        endif()
        target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(${target} PRIVATE -fsanitize=address,undefined)
    endif()
    if(LYKOWARE_CLANG_TIDY)
        set_target_properties(${target} PROPERTIES CXX_CLANG_TIDY "${LYKOWARE_CLANG_TIDY_EXE}")
    endif()
endfunction()
